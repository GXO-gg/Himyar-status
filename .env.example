# ---- Himyar Status Bot ----
# Copy to .env and fill in.  chmod 600 .env

# The status bot's own token
DISCORD_TOKEN=

# Where the other bots live on the server
BOTS_DIR=/home/himyar/bots

# Leave MONITOR_BOTS blank to auto-discover every folder in BOTS_DIR.
# Or pin the list explicitly (folder names = systemd unit names):
# MONITOR_BOTS=himyar-tickets,himyar-reminders,himyar-events,himyar-levels,himyar-economy,himyar-music,himyar-warden
MONITOR_BOTS=
EXCLUDE_BOTS=himyar-status

# ---- View 1: lightweight, main Himyar server ----
LIGHT_GUILD_ID=
LIGHT_CHANNEL_ID=
# Used only if LIGHT_CHANNEL_ID is empty:
LIGHT_CHANNEL_NAME=

# ---- View 2: full health, private server only ----
FULL_GUILD_ID=
FULL_CHANNEL_ID=
FULL_CHANNEL_NAME=

# ---- Timing ----
REFRESH_SECONDS=60
GUILD_REFRESH_SECONDS=300

# ---- Optional: DM this user ID when a bot goes down or comes back ----
ALERT_USER_ID=

STATE_FILE=state.json
