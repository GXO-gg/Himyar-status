# ---- Himyar Status Bot ----
# Copy to .env and fill in.  chmod 600 .env

# The status bot's own token
DISCORD_TOKEN=

# Your Discord user ID — used for the DM health view, /health, and alerts
OWNER_USER_ID=

# Where the other bots live on the server
BOTS_DIR=/home/himyar/bots

# Entries are  folder  or  folder=systemd-unit  when the two differ.
MONITOR_BOTS=himyar-tickets,himyar-reminders,himyar-events,himyar-levels,himyar-economy,himyar-music,himyar-warden=himyar-welcome-bot
# Non-Himyar bots on the same box, add above if you want them shown:
#   automod-plus,Green-Gang-roles=roles-bot,green-gang-contact-bot=contact-bot,Support-bot-1=support-bot
EXCLUDE_BOTS=himyar-status

# ---- View 1: lightweight, main Himyar server ----
LIGHT_GUILD_ID=
LIGHT_CHANNEL_ID=
LIGHT_CHANNEL_NAME=

# ---- View 2: full health ----
# dm      = DM the owner (default, nothing to set up)
# channel = post in FULL_CHANNEL_ID instead, which must NOT be in LIGHT_GUILD_ID
FULL_VIEW_MODE=dm
FULL_GUILD_ID=
FULL_CHANNEL_ID=
FULL_CHANNEL_NAME=

# ---- Timing ----
LIGHT_REFRESH_SECONDS=60
FULL_REFRESH_SECONDS=3600

# ---- Extras ----
ALERT_DM=true
ENABLE_HEALTH_COMMAND=true

STATE_FILE=state.json
