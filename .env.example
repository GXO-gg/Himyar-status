# ---- Himyar Status Bot ----
# Copy to .env and fill in.  chmod 600 .env

# The status bot's own token
DISCORD_TOKEN=

# Where the other bots live on the server
BOTS_DIR=/home/himyar/bots

# Entries are  folder  or  folder=systemd-unit  when the two differ.
# Leave blank to auto-discover every folder in BOTS_DIR (not recommended here —
# ~/bots also holds non-Himyar bots).
MONITOR_BOTS=himyar-tickets,himyar-reminders,himyar-events,himyar-levels,himyar-economy,himyar-music,himyar-warden=himyar-welcome-bot
# Non-Himyar bots on the same box, add to the line above if you want them shown:
#   automod-plus,Green-Gang-roles=roles-bot,green-gang-contact-bot=contact-bot,Support-bot-1=support-bot
EXCLUDE_BOTS=himyar-status

# ---- View 1: lightweight, main Himyar server ----
LIGHT_GUILD_ID=
LIGHT_CHANNEL_ID=
# Used only if LIGHT_CHANNEL_ID is empty:
LIGHT_CHANNEL_NAME=

# ---- View 2: full health, private server only ----
FULL_GUILD_ID=
FULL_CHANNEL_ID=
FULL_CHANNEL_NAME=

# ---- Timing ----
REFRESH_SECONDS=60
GUILD_REFRESH_SECONDS=300

# ---- Optional: DM this user ID when a bot goes down or comes back ----
ALERT_USER_ID=

STATE_FILE=state.json
